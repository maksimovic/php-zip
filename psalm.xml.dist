<?xml version="1.0"?>
<psalm
        errorLevel="3"
        resolveFromConfigFile="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Requires PHP 8.3+; this package supports PHP 7.4+. -->
        <MissingOverrideAttribute errorLevel="suppress" />

        <!-- Public library API. Psalm only sees internal call sites, not external consumers. -->
        <PossiblyUnusedMethod errorLevel="suppress" />
        <PossiblyUnusedReturnValue errorLevel="suppress" />
        <UnusedClass errorLevel="suppress" />

        <!-- Cleanup calls on PHP stream APIs (stream_filter_remove, stream_wrapper_unregister) return bool that's
             traditionally unchecked — failure in a finally block is unrecoverable. -->
        <UnusedFunctionCall errorLevel="suppress" />
    </issueHandlers>
</psalm>
